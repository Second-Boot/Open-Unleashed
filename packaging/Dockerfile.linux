FROM --platform=linux/amd64 rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libasound2-dev libudev-dev libx11-dev libxkbcommon-dev libwayland-dev \
      libxcursor-dev libxrandr-dev libxi-dev libxinerama-dev libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*
